{
  "name": "subscription-tracker",
  "version": "1.0.0",
  "engines": {
    "node": ">=18.0.0"
  },

  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "build": "npm install && npm install --prefix frontend && npm --prefix frontend run build",
    "start": "NODE_ENV=production node src/server.js",
    "dev": "nodemon src/server.js",
    "client": "npm --prefix frontend run dev",
    "client:build": "npm --prefix frontend run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notsomohit/subscription-tracker.git"
  },
  "author": "mohit",
  "license": "ISC",
  "dependencies": {
    "@arcjet/node": "^1.4.0",
    "@upstash/workflow": "^1.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",

    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "nodemailer": "^8.0.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
